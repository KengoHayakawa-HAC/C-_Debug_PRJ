# Tests for the executables built by DebuggingWorkshop.sln (x64).
if(NOT CTEST_CONFIGURATION_TYPE)
    set(CTEST_CONFIGURATION_TYPE "Debug")
endif()
if(NOT CTEST_CONFIGURATION_TYPE MATCHES "^(Debug|Release)$")
    message(FATAL_ERROR "Use ctest -C Debug or -C Release")
endif()
set(workshop_bin "${CMAKE_CURRENT_LIST_DIR}/../build-vs/x64/${CTEST_CONFIGURATION_TYPE}")
add_test(hp_spec "${workshop_bin}/hp_tests/hp_tests.exe")
add_test(chase_spec "${workshop_bin}/chase_tests/chase_tests.exe")
add_test(collision_spec "${workshop_bin}/collision_tests/collision_tests.exe")
add_test(boss_storage "${workshop_bin}/boss_tests/boss_tests.exe" storage)
add_test(boss_initialization "${workshop_bin}/boss_tests/boss_tests.exe" initialization)
add_test(move_transfer "${workshop_bin}/move_tests/move_tests.exe" transfer)
add_test(move_data "${workshop_bin}/move_tests/move_tests.exe" data)
