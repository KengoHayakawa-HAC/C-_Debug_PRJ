add_library(${EXERCISE}_logic exercise.cpp)
target_include_directories(${EXERCISE}_logic PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}")
add_executable(${EXERCISE}_demo main.cpp)
add_executable(${EXERCISE}_tests tests.cpp)
target_link_libraries(${EXERCISE}_demo PRIVATE ${EXERCISE}_logic)
target_link_libraries(${EXERCISE}_tests PRIVATE ${EXERCISE}_logic)
foreach(target ${EXERCISE}_logic ${EXERCISE}_demo ${EXERCISE}_tests)
    set_target_properties(${target} PROPERTIES CXX_STANDARD 17 CXX_STANDARD_REQUIRED YES CXX_EXTENSIONS NO)
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /utf-8)
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic)
    endif()
endforeach()
add_test(NAME ${EXERCISE}_spec COMMAND ${EXERCISE}_tests)
