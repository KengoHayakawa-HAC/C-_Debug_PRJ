{
  "version": 2,
  "configurePresets": [{
    "name": "workshop", "displayName": "Workshop - C++17 Debug",
    "generator": "Ninja", "binaryDir": "${sourceDir}/build",
    "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
